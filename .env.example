# Konfigurasi aplikasi Next.js + PostgreSQL (Bersihinkost)

DATABASE_URL="postgresql://postgres:password@localhost:5432/bersihinkost?schema=public"

# Kunci rahasia untuk menandatangani JWT sesi admin
JWT_SECRET="ganti-dengan-kunci-rahasia-yang-panjang-dan-acak"
JWT_EXPIRES_IN="7d"

# URL aplikasi (digunakan untuk link sukses & WhatsApp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
