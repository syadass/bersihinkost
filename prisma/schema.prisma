// prisma/schema.prisma
// Skema database Postgreksi yang mencerminkan struktur asli Laravel (bersihinkost).
// Semua tanggal disimpan dalam timezone Asia/Jakarta (WIB), sama seperti aslinya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  name              String   @db.VarChar(100)
  email             String   @unique @db.VarChar(100)
  password          String   @db.VarChar(255)
  email_verified_at DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(100)
  token     String   @unique @db.VarChar(255)
  created_at DateTime @default(now())
}

model Service {
  id            Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  category      String     @db.VarChar(50)
  price         Int
  duration_minutes Int     @default(30) @db.Integer
  image_url     String?    @db.Text
  is_active     Boolean    @default(true)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt
  order_items   OrderItem[]
}

model Setting {
  id               Int      @id @default(1)
  admin_wa_number  String   @default("6281234567890") @db.VarChar(20)
  operator_name    String   @default("Syada Saleha") @db.VarChar(100)
  is_open          Boolean  @default(true)
  business_name    String   @default("Bersihinkost") @db.VarChar(100)
  jam_mulai        String   @default("08:00") @db.VarChar(5)
  jam_selesai      String   @default("17:00") @db.VarChar(5)
  catatan_publik   String?  @db.Text
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
}

model Order {
  id              Int       @id @default(autoincrement())
  customer_name   String    @db.VarChar(100)
  customer_wa     String    @default("") @db.VarChar(20)
  alamat          String    @db.Text
  tanggal_usulan  DateTime
  tanggal_fix     DateTime?
  total_harga     Int       @default(0)
  estimasi_menit  Int       @default(0)
  status          String    @default("pending") @db.VarChar(20)
  alasan_batal    String?   @db.Text
  catatan_admin   String?   @db.Text
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  order        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  order_id     Int
  service      Service? @relation(fields: [service_id], references: [id], onDelete: SetNull)
  service_id   Int?
  service_name String   @db.VarChar(100)
  qty          Int      @default(1)
  harga_satuan Int
  subtotal     Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ClosureDate {
  id          Int      @id @default(autoincrement())
  tanggal     DateTime @unique @db.Date
  keterangan  String?  @db.VarChar(100)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}
